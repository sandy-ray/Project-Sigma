# Anthropic API key for server-side draft credit analysis.
# Copy to .env and restart auth_server.py serve
# Keep the full key on ONE line (no line breaks).
ANTHROPIC_API_KEY=

# Optional — defaults to claude-sonnet-4-6
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional — max output tokens for draft analysis (default 64000)
# ANTHROPIC_MAX_TOKENS=64000

# Optional — send extracted fields + findings only (much faster; default off)
# ANTHROPIC_FAST_ANALYSIS=1

# Optional second login for demos: a Credit Supervisor (can undo overrides)
# SIGMA_BOOTSTRAP_SUPERVISOR_EMAIL=
# SIGMA_BOOTSTRAP_SUPERVISOR_PASSWORD=
# SIGMA_BOOTSTRAP_SUPERVISOR_NAME=Credit Supervisor
